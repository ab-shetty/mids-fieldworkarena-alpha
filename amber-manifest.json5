// Amber manifest for the FieldWorkArena purple agent.
//
// Submitters reference this file from a submissions/<uuid>.json entry in
// their fork of RDI-Foundation/FieldWorkArena-agentbeats-leaderboard.
//
// Pin to an immutable digest at submission time:
//   ghcr.io/<YOUR_GHCR_USER>/purple-agent-fwa@sha256:<DIGEST>
{
  manifest_version: "0.1.0",
  program: {
    image: "ghcr.io/ab-shetty/mids-fieldworkarena-alpha:latest",
    entrypoint: [
      "python",
      "-m",
      "src.server",
      "--host", "0.0.0.0",
      "--port", "8080",
    ],
    env: {
      OPENAI_API_KEY: "${config.agent_openai_api_key}",
      OPENAI_MODEL: "${config.agent_openai_model}",
      REASONING_EFFORT: "${config.agent_reasoning_effort}",
      REASONING_EFFORT_JSON: "${config.agent_reasoning_effort_json}",
      REASONING_EFFORT_NUMERIC: "${config.agent_reasoning_effort_numeric}",
      MAX_IMAGE_EDGE: "${config.agent_max_image_edge}",
      LOG_LEVEL: "INFO",
    },
    network: {
      endpoints: [
        { name: "endpoint", port: 8080 },
      ],
    },
  },
  config_schema: {
    type: "object",
    properties: {
      agent_openai_api_key:           { type: "string", secret: true },
      agent_openai_model:             { type: "string" },
      agent_reasoning_effort:         { type: "string" },
      agent_reasoning_effort_json:    { type: "string" },
      agent_reasoning_effort_numeric: { type: "string" },
      agent_max_image_edge:           { type: "string" },
    },
    additionalProperties: false,
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" },
  },
  exports: {
    a2a: "a2a",
  },
}
